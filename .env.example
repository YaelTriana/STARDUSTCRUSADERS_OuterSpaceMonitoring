# Copia a .env (tirelus.ps1 lo hace solo y genera la contrasena). .env NO se sube al repo.
TIRELUS_DB_PASSWORD=cambia-esto
TIRELUS_DB_NAME=tirelus
TIRELUS_DB_USER=postgres
# Puerto de la API en este equipo y puerto publicado de PostgreSQL.
TIRELUS_API_PORT=8765
TIRELUS_DB_PUBLISH_PORT=5432
# 127.0.0.1 = solo este equipo. Para compartir la base en la red local: 0.0.0.0 (o usa -Lan).
TIRELUS_DB_BIND=127.0.0.1
